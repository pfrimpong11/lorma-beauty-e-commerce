# ==========================================================================
# Lorma Beauty POS — environment template
# Copy to .env and replace every value. NEVER commit the real .env.
# ==========================================================================

# --- Application ----------------------------------------------------------
NODE_ENV=development
APP_NAME="Lorma Beauty POS"
CURRENCY=GHS
CURRENCY_LOCALE=en-GH
TZ=Africa/Accra

# --- PostgreSQL (container) ----------------------------------------------
POSTGRES_USER=lorma
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=lorma_beauty_pos
# Host port for dev access. The in-network port is always 5432.
POSTGRES_PORT=5433

# --- Database connection --------------------------------------------------
# Inside Docker the host is the compose service name, not localhost.
# For an external managed database, replace this whole URL.
DATABASE_URL=postgresql://lorma:change_me_in_production@postgres:5432/lorma_beauty_pos?schema=public

# --- Backend (NestJS) -----------------------------------------------------
BACKEND_PORT=4000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Trust X-Forwarded-* headers when behind a reverse proxy
TRUST_PROXY=false
# Cookies are only sent over HTTPS when this is true (set true in production)
COOKIE_SECURE=false
COOKIE_DOMAIN=
# SameSite for the session cookie. Leave empty to derive it from
# COOKIE_SECURE. Set to `lax` when the API is proxied under the frontend's
# origin (docker-compose.tunnel.yml does this).
COOKIE_SAMESITE=
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
LOG_LEVEL=info

# --- Frontend (Next.js) ---------------------------------------------------
# Host port. Change if 3000 is taken; the in-container port is always 3000.
FRONTEND_PORT=3200
# Public URL the BROWSER uses to reach the API — not the Docker service name.
# Leave this as-is for local use. When the POS is reached through a tunnel or
# reverse proxy, use docker-compose.tunnel.yml instead, which proxies the API
# under the frontend's own origin and ignores this value.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the frontend forwards same-origin /api calls. Defaults to the backend
# service inside Compose, which is what you want. Leave it alone unless you
# deliberately want browsers calling NEXT_PUBLIC_API_URL directly, in which
# case set it empty — clients other than this machine will then need
# NEXT_PUBLIC_API_URL to be an address they can actually reach.
# API_PROXY_TARGET=http://backend:4000
NEXT_PUBLIC_APP_NAME="Lorma Beauty POS"
NEXT_PUBLIC_CURRENCY=GHS
NEXT_PUBLIC_CURRENCY_LOCALE=en-GH
# Days before expiry a product starts warning
NEXT_PUBLIC_EXPIRY_WARNING_DAYS=30

# --- Seed (development only) ----------------------------------------------
# These credentials are for local development ONLY. Never use in production.
# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# NODE_ENV=production makes the seed refuse to run without an explicit
# override. Leave it unset for local development.
#
# SEED_DEMO_DATA=true loads 28 invented products and 3 invented customers.
# DEVELOPMENT AND STAGING ONLY — the seed refuses to combine it with
# NODE_ENV=production. Without it the seed still creates everything a real
# shop needs: permissions, roles, users, categories, settings, counters and
# the Walk-in Customer.
SEED_DEMO_DATA=true

# ALLOW_PRODUCTION_SEED=true is required for the one-off bootstrap of an
# empty production database. Never set it permanently; pass it on the single
# command. See docs/DEPLOYMENT.md.
# ALLOW_PRODUCTION_SEED=

# The first two accounts. Required, non-empty, and at least 12 characters,
# whenever SEED_DEMO_DATA is not true — the values below are published in
# the README and are development credentials only.
#
# The seed never changes an existing user's password. Changing these after
# the first run has no effect; use the app to change a password.
SEED_ADMIN_EMAIL=admin@lormabeauty.local
SEED_ADMIN_PASSWORD=LormaAdmin!2024
SEED_CASHIER_EMAIL=cashier@lormabeauty.local
SEED_CASHIER_PASSWORD=LormaCashier!2024

# ---------------------------------------------------------------------------
# SMS receipts (Arkesel)
# ---------------------------------------------------------------------------
# Leave SMS_PROVIDER empty and the shop trades exactly as before: every
# receipt message is still recorded, with status QUEUED, and nothing is sent.
# Set it to "arkesel" with a key from https://sms.arkesel.com to start sending.
#
# The sender ID must be registered with Arkesel first and is capped at 11
# characters; an unregistered one is rejected at their end, not ours.
SMS_PROVIDER=
ARKESEL_API_KEY=
SMS_SENDER_ID=LormaBeauty
